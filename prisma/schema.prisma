generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  MANAGER
  CUSTOMER
}

enum Region {
  US
  CA
  KR
}

enum Source {
  COPART
  IAAI
  ENCAR
  KCAR
  AUTOWINI
  OTHER
}

enum SaleType {
  AUCTION
  BUY_NOW
}

enum Condition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  DAMAGED
  SALVAGE
}

enum VehicleStatus {
  AVAILABLE
  RESERVED
  SOLD
  ARCHIVED
}

enum InquiryType {
  VEHICLE
  CALCULATOR
  WIZARD
  CONTACT
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  CLOSED
}

enum OfferStatus {
  SENT
  ACCEPTED
  DECLINED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  role         Role     @default(CUSTOMER)
  notifyEmail  Boolean  @default(true)
  consentAt    DateTime?
  createdAt    DateTime @default(now())

  favorites     Favorite[]
  inquiries     Inquiry[]
  offers        Offer[]
  orders        Order[]
  documents     Document[]
  notifications Notification[]
  savedSearches SavedSearch[]
}

model Vehicle {
  id              String        @id @default(cuid())
  slug            String        @unique
  region          Region
  source          Source
  sourceId        String?
  isDemo          Boolean       @default(false)
  make            String
  model           String
  trim            String?
  year            Int
  vin             String?
  lotNumber       String?
  platform        String?
  saleType        SaleType      @default(AUCTION)
  currency        String        @default("USD")
  currentBid      Int?
  buyNowPrice     Int?
  priceEur        Int           @default(0)
  bidEur          Int?
  auctionDate     DateTime?
  location        String
  country         String
  odometerKm      Int
  engine          String
  fuel            String
  transmission    String
  drive           String
  bodyType        String
  color           String
  condition       Condition     @default(GOOD)
  primaryDamage   String?
  secondaryDamage String?
  runsAndDrives   Boolean       @default(true)
  hasKeys         Boolean       @default(true)
  description     String
  features        String[]
  status          VehicleStatus @default(AVAILABLE)
  featured        Boolean       @default(false)
  published       Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  images    VehicleImage[]
  history   VehicleHistoryEvent[]
  favorites Favorite[]
  inquiries Inquiry[]

  @@index([region, status, published])
  @@index([make, model])
  @@index([vin])
  @@index([priceEur])
  @@index([auctionDate])
}

model VehicleImage {
  id        String  @id @default(cuid())
  vehicleId String
  url       String
  alt       String?
  position  Int     @default(0)
  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, position])
}

model VehicleHistoryEvent {
  id          String   @id @default(cuid())
  vehicleId   String
  date        DateTime
  type        String
  description String
  odometerKm  Int?
  source      String?
  vehicle     Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, date])
}

model Favorite {
  userId    String
  vehicleId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@id([userId, vehicleId])
}

model Inquiry {
  id         String        @id @default(cuid())
  type       InquiryType   @default(VEHICLE)
  status     InquiryStatus @default(NEW)
  userId     String?
  vehicleId  String?
  name       String
  email      String
  phone      String?
  message    String?
  payload    Json?
  consentAt  DateTime
  managerNote String?
  createdAt  DateTime      @default(now())
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  vehicle    Vehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  offers     Offer[]

  @@index([status, createdAt])
}

model Offer {
  id          String      @id @default(cuid())
  inquiryId   String?
  userId      String
  title       String
  totalEur    Int
  breakdown   Json?
  notes       String?
  status      OfferStatus @default(SENT)
  validUntil  DateTime?
  createdAt   DateTime    @default(now())
  inquiry     Inquiry?    @relation(fields: [inquiryId], references: [id], onDelete: SetNull)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Order {
  id           String       @id @default(cuid())
  number       String       @unique
  userId       String
  vehicleTitle String
  vin          String
  stage        Int          @default(1)
  estimatedDelivery DateTime?
  createdAt    DateTime     @default(now())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  events       OrderEvent[]
  documents    Document[]

  @@index([vin])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  stage     Int
  title     String
  note      String?
  location  String?
  lat       Float?
  lng       Float?
  isPublic  Boolean  @default(true)
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
}

model Document {
  id        String   @id @default(cuid())
  userId    String
  orderId   String?
  name      String
  url       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  order     Order?   @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  href      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model SavedSearch {
  id         String   @id @default(cuid())
  userId     String
  name       String
  query      String
  notify     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Setting {
  key   String @id
  value Json
}

model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  body        String
  cover       String?
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
}

model Faq {
  id       String @id @default(cuid())
  question String
  answer   String
  position Int    @default(0)
}

model Review {
  id        String   @id @default(cuid())
  author    String
  city      String?
  rating    Int      @default(5)
  text      String
  vehicle   String?
  published Boolean  @default(true)
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model CompletedDelivery {
  id          String   @id @default(cuid())
  title       String
  year        Int
  origin      Region
  days        Int
  city        String?
  imageUrl    String?
  isDemo      Boolean  @default(false)
  deliveredAt DateTime
}

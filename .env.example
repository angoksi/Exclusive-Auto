# PostgreSQL връзка
DATABASE_URL="postgresql://user:password@localhost:5432/eat"
# Таен ключ за сесиите (поне 32 символа): openssl rand -base64 48
AUTH_SECRET=""
SITE_URL="https://example.com"

# Доставчици на данни (по лицензирани API/фийдове). Без ключ се ползват демо данни.
ENCAR_API_URL=""
ENCAR_API_KEY=""
KCAR_API_URL=""
KCAR_API_KEY=""
AUTOWINI_API_URL=""
AUTOWINI_API_KEY=""
# Доставчик на VIN история (по избор)
VIN_HISTORY_API_URL=""
VIN_HISTORY_API_KEY=""

# Carapis (платен API с обяви от корейски платформи) — виж docs.carapis.com
CARAPIS_API_KEY=""
CARAPIS_MAX_LISTINGS="1000"
# CARAPIS_MAX_PAGES="100"
# CARAPIS_DELAY_MS="500"   # пауза между заявките към Carapis (увеличете при 429)
# CARAPIS_PHOTO_BATCH="10"
CARAPIS_SOURCE="encar"   # платформи по source_code (разделени със запетая); зареждат се само автомобили от Корея
# CARAPIS_QUERY="make=Hyundai"   # допълнителни филтри по документацията на Carapis
# SYNC_INTERVAL_MINUTES="30"    # на колко минути сайтът сам проверява доставчика (минимум 5)
CRON_SECRET=""
